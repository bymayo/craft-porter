{% import '_includes/forms' as forms %}

<p>
    {{ 'Users with an expired password:'|t('porter') }} <strong>{{ expired }}</strong><br>
    {{ 'Users whose password expires soon:'|t('porter') }} <strong>{{ expiringSoon }}</strong>
</p>

{% if canForceReset %}

    {% if expired %}

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('porter/retention/force-reset-passwords') }}
            {{ redirectInput('utilities/porter-password-retention') }}

            <p class="light">
                {{ 'Flags every user above as needing a password reset, and emails them if the notification is enabled. Admins and exempt groups are skipped.'|t('porter') }}
            </p>

            <button type="submit" class="btn submit">{{ 'Force Reset Passwords'|t('porter') }}</button>
        </form>

    {% else %}

        <p class="light">{{ 'Nothing to reset right now.'|t('porter') }}</p>

    {% endif %}

{% else %}

    <p class="light">{{ 'You don’t have permission to force reset passwords.'|t('porter') }}</p>

{% endif %}
