{% extends '_layouts/cp' %}

{% do view.registerAssetBundle("bymayo\\porter\\assetbundles\\porter\\PorterAsset") %}

{% import "_includes/forms" as forms %}

{% set fullPageForm = true %}

{% set title = 'Porter Settings' %}

{% set tabs = {
    account: {
        label: 'Account',
        url: '#account'
    },
    login: {
        label: 'Login',
        url: '#login'
    },
    email: {
        label: 'Email',
        url: '#email-password'
    },
    password: {
        label: 'Password Policy',
        url: '#password-policy'
    },
    notifications: {
        label: 'Notifications',
        url: '#email-notifications'
    }
} %}

{% block content %}

    <input type="hidden" name="action" value="porter/settings/save">
    <input type="hidden" name="pluginHandle" value="porter">

    <div id="account">

        <h2>Delete Account</h2>

        {{ forms.lightswitchField({
            label: 'Allow users to delete their own account',
            id: 'deleteAccount',
            name: 'settings[deleteAccount]',
            on: settings['deleteAccount'],
            toggle: 'deleteAccount-options'
        }) }}

        <div id="deleteAccount-options">

            {{ forms.selectField({
                label: 'Confirmation Type',
                id: 'deleteAccountConfirmationType',
                name: 'settings[deleteAccountConfirmationType]',
                value: settings['deleteAccountConfirmationType'],
                toggle: true,
                options: [
                    { value: 'confirmationTypeKeyword', label: 'Keyword (E.g. DELETE)' },
                    { value: 'confirmationTypeField', label: 'Field (E.g. First Name)' }
                ]
            }) }}

            <div id="confirmationTypeKeyword"{% if settings['deleteAccountConfirmationType'] != 'confirmationKeyword' %} class="hidden"{% endif %}>
                {{ forms.textField({
                    label: 'Confirmation Keyword',
                    instructions: 'The word users must type to confirm deletion.',
                    id: 'deleteAccountConfirmationKeyword',
                    name: 'settings[deleteAccountConfirmationKeyword]',
                    value: settings['deleteAccountConfirmationKeyword']})
                }}
            </div>

            <div id="confirmationTypeField"{% if settings['deleteAccountConfirmationType'] != 'confirmationField' %} class="hidden"{% endif %}>
                {{ forms.selectField({
                    label: 'Confirmation Field',
                    instructions: 'The user field that must match to confirm deletion.',
                    id: 'deleteAccountConfirmationField',
                    name: 'settings[deleteAccountConfirmationField]',
                    value: settings['deleteAccountConfirmationField'],
                    options: [
                        { value: 'fullName', label: 'Full Name' },
                        { value: 'firstName', label: 'First Name' },
                        { value: 'lastName', label: 'Last Name' },
                        { value: 'email', label: 'Email' }
                    ]
                }) }}
            </div>

            {{ forms.textField({
                label: 'Redirect',
                instructions: 'Where users are sent afterwards. Can be overridden in your template with `redirect`.',
                id: 'deleteAccountRedirect',
                name: 'settings[deleteAccountRedirect]',
                value: settings['deleteAccountRedirect'],
                placeholder: '/'
            }) }}

            {# {{ forms.elementSelectField({
                label: "Transfer content to",
                instructions: 'If the deleted user has content, transfer it to a new user.',
                id: 'deleteAccountTransfer',
                name: 'settings[deleteAccountTransfer]',
                elementType: "craft\\elements\\User",
                selectionLabel: "Choose a User",
                elements: [settings.deleteAccountTransfer],
                limit: 1
            }) }} #}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Deactivate Account</h2>

        {{ forms.lightswitchField({
            label: 'Allow users to deactivate their own account',
            id: 'deactivateAccount',
            name: 'settings[deactivateAccount]',
            on: settings['deactivateAccount'],
            toggle: 'deactivateAccount-options'
        }) }}

        <div id="deactivateAccount-options">

            {{ forms.textField({
                label: 'Redirect',
                instructions: 'Where users are sent afterwards. Can be overridden in your template with `redirect`.',
                id: 'deactivateAccountRedirect',
                name: 'settings[deactivateAccountRedirect]',
                value: settings['deactivateAccountRedirect'],
                placeholder: '/'
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Inactive Account Cleanup</h2>

        {{ forms.lightswitchField({
            label: 'Automatically deactivate inactive accounts',
            instructions: 'Warn and then deactivate accounts that haven’t signed in for a while. Admins and users with control panel access are skipped.',
            id: 'inactiveAccountCleanup',
            name: 'settings[inactiveAccountCleanup]',
            on: settings['inactiveAccountCleanup'],
            toggle: 'inactiveAccountCleanup-options'
        }) }}

        <div id="inactiveAccountCleanup-options">

            {{ forms.textField({
                label: 'Send reminder after',
                instructions: 'Days of inactivity before the warning email is sent.',
                id: 'inactiveAccountReminderDays',
                name: 'settings[inactiveAccountReminderDays]',
                value: settings['inactiveAccountReminderDays'],
                size: 4
            }) }}

            {{ forms.textField({
                label: 'Deactivate after',
                instructions: 'Days of inactivity before the account is deactivated.',
                id: 'inactiveAccountDeactivateDays',
                name: 'settings[inactiveAccountDeactivateDays]',
                value: settings['inactiveAccountDeactivateDays'],
                size: 4
            }) }}

        </div>

    </div>

    <div id="login" class="hidden">

        <h2>Magic Link</h2>

        {{ forms.lightswitchField({
            label: 'Allow users to login via a magic link',
            id: 'magicLink',
            name: 'settings[magicLink]',
            on: settings['magicLink'],
            toggle: 'magicLink-options'
        }) }}

        <div id="magicLink-options">

            {{ forms.lightswitchField({
                label: 'Control Panel Access',
                instructions: 'Enable Magic Link for users with CP access.',
                id: 'magicLinkControlPanel',
                name: 'settings[magicLinkControlPanel]',
                on: settings['magicLinkControlPanel']
            }) }}

            {{ forms.lightswitchField({
                label: 'Front End Login',
                id: 'magicLinkFrontEnd',
                name: 'settings[magicLinkFrontEnd]',
                on: settings['magicLinkFrontEnd']
            }) }}

            {{ forms.textField({
                label: 'Expiry Timeframe',
                instructions: 'Seconds before a magic link expires.',
                id: 'magicLinkExpirySeconds',
                name: 'settings[magicLinkExpirySeconds]',
                value: settings['magicLinkExpirySeconds']})
            }}

            {{ forms.textField({
                label: 'Redirect',
                instructions: 'Where users are sent afterwards. Can be overridden in your template with `redirect`.',
                id: 'magicLinkRedirect',
                name: 'settings[magicLinkRedirect]',
                value: settings['magicLinkRedirect'],
                placeholder: '/'
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Failed Login Attempts</h2>

        {{ forms.textField({
            label: 'Threshold',
            instructions: 'Failed sign in attempts that trigger the notification email.',
            id: 'emailFailedLoginAttemptsThreshold',
            name: 'settings[emailFailedLoginAttemptsThreshold]',
            value: settings['emailFailedLoginAttemptsThreshold'],
            size: 4
        }) }}

    </div>

    <div id="email-password" class="hidden">

        <h2>Block Burner / Disposable Emails</h2>

        {{ forms.lightswitchField({
            label: 'Block disposable, non-existent domain or invalid emails',
            id: 'emailBurners',
            name: 'settings[emailBurners]',
            on: settings['emailBurners'],
            toggle: 'emailBurners-options'
        }) }}

        <div id="emailBurners-options">

            {{ forms.textField({
                label: 'Verifier API Key',
                instructions: 'Get your free API key from https://verifier.meetchopra.com.',
                id: 'emailsBurnersVerifierApiKey',
                name: 'settings[emailsBurnersVerifierApiKey]',
                value: settings['emailsBurnersVerifierApiKey']
            }) }}

        </div>

    </div>

    <div id="password-policy" class="hidden">

        <h2>Length &amp; Characters</h2>

        {{ forms.lightswitchField({
            label: 'Enforce a length and character make-up',
            id: 'passwordForcePolicy',
            name: 'settings[passwordForcePolicy]',
            on: settings['passwordForcePolicy'],
            toggle: 'passwordForcePolicy-options'
        }) }}

        <div id="passwordForcePolicy-options">

            {{ forms.textField({
                label: 'Minimum Length',
                instructions: 'Can’t be lower than 6, which is Craft’s own minimum.',
                id: 'passwordForcePolicyMin',
                name: 'settings[passwordForcePolicyMin]',
                value: settings['passwordForcePolicyMin'],
                size: 4
            }) }}

            {{ forms.textField({
                label: 'Maximum Length',
                instructions: '0 for no limit. Craft caps at 160.',
                id: 'passwordForcePolicyMax',
                name: 'settings[passwordForcePolicyMax]',
                value: settings['passwordForcePolicyMax'],
                size: 4
            }) }}

            {{ forms.checkboxSelectField({
                label: 'Required Characters',
                id: 'passwordForcePolicyRules',
                name: 'settings[passwordForcePolicyRules]',
                options: [
                    { value: 'lowercase', label: 'A lower case character (a-z)' },
                    { value: 'uppercase', label: 'An upper case character (A-Z)' },
                    { value: 'numeric', label: 'A number (0-9)' },
                    { value: 'symbol', label: 'A symbol (@, #, $ etc)' }
                ],
                values: settings['passwordForcePolicyRules'],
                showAllOption: false
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Password Strength</h2>

        {{ forms.lightswitchField({
            label: 'Show a password strength indicator',
            instructions: 'Adds a strength meter and checklist to control panel password fields. For front end use, see the [documentation](https://github.com/bymayo/craft-porter/blob/craft-5/README.md#strength-indicator).',
            id: 'passwordStrengthIndicator',
            name: 'settings[passwordStrengthIndicator]',
            on: settings['passwordStrengthIndicator'],
            toggle: 'passwordStrengthIndicator-options'
        }) }}

        <div id="passwordStrengthIndicator-options">

            {{ forms.selectField({
                label: 'Minimum Strength',
                id: 'passwordStrengthMinScore',
                name: 'settings[passwordStrengthMinScore]',
                value: settings['passwordStrengthMinScore'],
                options: [
                    { value: 0, label: 'Don’t enforce' },
                    { value: 1, label: 'Weak' },
                    { value: 2, label: 'Fair' },
                    { value: 3, label: 'Good' },
                    { value: 4, label: 'Strong' }
                ]
            }) }}

            {{ forms.lightswitchField({
                label: 'Add a CSP nonce to the indicator script',
                instructions: 'The indicator needs a small inline script, which a Content Security Policy will block. Switching this on stamps a nonce on it, which your CSP header then needs to include. See the [documentation](https://github.com/bymayo/craft-porter/blob/craft-5/README.md#strength-indicator).',
                id: 'passwordCspNonce',
                name: 'settings[passwordCspNonce]',
                on: settings['passwordCspNonce']
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Breach Check</h2>

        {{ forms.lightswitchField({
            label: 'Check against Have I Been Pwned',
            instructions: 'Rejects passwords found in a known data breach.',
            id: 'passwordPwned',
            name: 'settings[passwordPwned]',
            on: settings['passwordPwned'],
            toggle: 'passwordPwned-options'
        }) }}

        <div id="passwordPwned-options">

            {{ forms.selectField({
                label: 'If the check can’t be reached',
                id: 'passwordPwnedFailMode',
                name: 'settings[passwordPwnedFailMode]',
                value: settings['passwordPwnedFailMode'],
                options: [
                    { value: 'open', label: 'Allow the password' },
                    { value: 'closed', label: 'Reject the password' }
                ]
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Blocklist</h2>

        {{ forms.lightswitchField({
            label: 'Block easily guessed passwords',
            id: 'passwordBlocklist',
            name: 'settings[passwordBlocklist]',
            on: settings['passwordBlocklist'],
            toggle: 'passwordBlocklist-options'
        }) }}

        <div id="passwordBlocklist-options">

            {{ forms.checkboxSelectField({
                label: 'Block',
                id: 'passwordBlocklistSources',
                name: 'settings[passwordBlocklistSources]',
                options: [
                    { value: 'userDetails', label: 'The user’s own username, name and email' },
                    { value: 'siteName', label: 'The site name' },
                    { value: 'substitutions', label: 'Character swaps, so “password” also blocks “P4ssw0rd”' }
                ],
                values: settings['passwordBlocklistSources'],
                showAllOption: false
            }) }}

            {{ forms.textareaField({
                label: 'Banned Words',
                instructions: 'One per line. Words under 3 characters are ignored.',
                id: 'passwordBlocklistWords',
                name: 'settings[passwordBlocklistWords]',
                value: settings['passwordBlocklistWords'],
                rows: 4
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Password History</h2>

        {{ forms.lightswitchField({
            label: 'Stop users reusing old passwords',
            instructions: 'Only remembers passwords changed from now on.',
            id: 'passwordHistory',
            name: 'settings[passwordHistory]',
            on: settings['passwordHistory'],
            toggle: 'passwordHistory-options'
        }) }}

        <div id="passwordHistory-options">

            {{ forms.textField({
                label: 'Passwords To Remember',
                instructions: 'Between 1 and 24. Higher numbers make saving slower.',
                id: 'passwordHistoryCount',
                name: 'settings[passwordHistoryCount]',
                value: settings['passwordHistoryCount'],
                size: 4
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Password Expiry</h2>

        {{ forms.lightswitchField({
            label: 'Expire passwords after a set period',
            instructions: 'Requires a CRON to function. See the [documentation](https://github.com/bymayo/craft-porter/blob/craft-5/README.md#password-expiry).',
            id: 'passwordExpiry',
            name: 'settings[passwordExpiry]',
            on: settings['passwordExpiry'],
            toggle: 'passwordExpiry-options'
        }) }}

        <div id="passwordExpiry-options">

            {% set expiryInput %}
                <div class="flex">
                    <div>
                        {{ forms.text({
                            id: 'passwordExpiryAmount',
                            name: 'settings[passwordExpiryAmount]',
                            value: settings['passwordExpiryAmount'],
                            size: 4
                        }) }}
                    </div>
                    <div>
                        {{ forms.select({
                            id: 'passwordExpiryPeriod',
                            name: 'settings[passwordExpiryPeriod]',
                            value: settings['passwordExpiryPeriod'],
                            options: [
                                { value: 'days', label: 'Day(s)' },
                                { value: 'weeks', label: 'Week(s)' },
                                { value: 'months', label: 'Month(s)' },
                                { value: 'years', label: 'Year(s)' }
                            ]
                        }) }}
                    </div>
                </div>
            {% endset %}

            {{ forms.field({
                label: 'Expire After',
                id: 'passwordExpiryAmount'
            }, expiryInput) }}

            {{ forms.textField({
                label: 'Warn This Many Days Before',
                instructions: 'Sends a “Password Expiring Soon” email, which can be switched on and edited on the [Notifications](' ~ cpUrl('settings/plugins/porter') ~ '#email-notifications) tab.',
                id: 'passwordExpiryWarningDays',
                name: 'settings[passwordExpiryWarningDays]',
                value: settings['passwordExpiryWarningDays'],
                size: 4
            }) }}

            {{ forms.textField({
                label: 'Redirect',
                instructions: 'Where front end users with an expired password are sent. Leave blank to handle it in your template with `craft.porter.passwordExpired`. See the [documentation](https://github.com/bymayo/craft-porter/blob/craft-5/README.md#password-expiry).',
                id: 'passwordExpiryFrontEndRedirect',
                name: 'settings[passwordExpiryFrontEndRedirect]',
                value: settings['passwordExpiryFrontEndRedirect'],
                placeholder: 'set-password'
            }) }}

        </div>

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Exemptions</h2>

        {{ forms.lightswitchField({
            label: 'Exempt admins',
            instructions: 'Applies to all Password Policy settings.',
            id: 'passwordExemptAdmins',
            name: 'settings[passwordExemptAdmins]',
            on: settings['passwordExemptAdmins']
        }) }}

        {% set userGroups = [] %}
        {% for group in craft.app.userGroups.getAllGroups() %}
            {% set userGroups = userGroups|merge([{ value: group.uid, label: group.name }]) %}
        {% endfor %}

        {% if userGroups %}
            {{ forms.checkboxSelectField({
                label: 'Exempt These Groups',
                id: 'passwordExemptGroups',
                name: 'settings[passwordExemptGroups]',
                options: userGroups,
                values: settings['passwordExemptGroups'],
                showAllOption: false
            }) }}
        {% endif %}

    </div>

    <div id="email-notifications" class="hidden">

        <h2>Account</h2>

        {{ forms.lightswitchField({
            label: 'Welcome Email',
            instructions: 'Sent when a user’s account is activated.',
            id: 'emailWelcome',
            name: 'settings[emailWelcome]',
            on: settings['emailWelcome']
        }) }}

        {{ forms.lightswitchField({
            label: 'Email Address Changed',
            instructions: 'Sent to a user’s previous address when their email is changed.',
            id: 'emailAddressChanged',
            name: 'settings[emailAddressChanged]',
            on: settings['emailAddressChanged']
        }) }}

        {{ forms.lightswitchField({
            label: 'Account Suspended',
            instructions: 'Sent when a user’s account is suspended.',
            id: 'emailAccountSuspended',
            name: 'settings[emailAccountSuspended]',
            on: settings['emailAccountSuspended']
        }) }}

        {{ forms.lightswitchField({
            label: 'Account Restored',
            instructions: 'Sent when a suspended account is restored.',
            id: 'emailAccountUnsuspended',
            name: 'settings[emailAccountUnsuspended]',
            on: settings['emailAccountUnsuspended']
        }) }}

        {{ forms.lightswitchField({
            label: 'Account Deactivated',
            instructions: 'Sent when a user’s account is deactivated.',
            id: 'emailAccountDeactivated',
            name: 'settings[emailAccountDeactivated]',
            on: settings['emailAccountDeactivated']
        }) }}

        {{ forms.lightswitchField({
            label: 'Account Deleted',
            instructions: 'Sent when a user’s account is deleted.',
            id: 'emailAccountDeleted',
            name: 'settings[emailAccountDeleted]',
            on: settings['emailAccountDeleted']
        }) }}

        {{ forms.lightswitchField({
            label: 'Inactive Account Reminder',
            instructions: 'Sent when a user hasn’t signed in for a while, before their account is deactivated.',
            id: 'emailInactiveAccountReminder',
            name: 'settings[emailInactiveAccountReminder]',
            on: settings['emailInactiveAccountReminder']
        }) }}

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Sign In</h2>

        {{ forms.lightswitchField({
            label: 'New Device Login Detected',
            instructions: 'Sent when a user signs in from a new IP or device.',
            id: 'emailNewDeviceLogin',
            name: 'settings[emailNewDeviceLogin]',
            on: settings['emailNewDeviceLogin']
        }) }}

        {{ forms.lightswitchField({
            label: 'Failed Login Attempts',
            instructions: 'Sent when consecutive failed sign in attempts cross the configured threshold.',
            id: 'emailFailedLoginAttempts',
            name: 'settings[emailFailedLoginAttempts]',
            on: settings['emailFailedLoginAttempts']
        }) }}

        <hr style="margin-left: calc(-1 * var(--padding)); margin-right: calc(-1 * var(--padding));">

        <h2>Password</h2>

        {{ forms.lightswitchField({
            label: 'Password Changed',
            instructions: 'Sent when a user’s password is changed.',
            id: 'emailPasswordChanged',
            name: 'settings[emailPasswordChanged]',
            on: settings['emailPasswordChanged']
        }) }}

        {{ forms.lightswitchField({
            label: 'Password Expiring Soon',
            instructions: 'Sent before a user’s password expires, so they can change it before being forced to.',
            id: 'emailPasswordExpiring',
            name: 'settings[emailPasswordExpiring]',
            on: settings['emailPasswordExpiring']
        }) }}

        {{ forms.lightswitchField({
            label: 'Password Expired',
            instructions: 'Sent when a user’s password expires and a reset is required.',
            id: 'emailPasswordExpired',
            name: 'settings[emailPasswordExpired]',
            on: settings['emailPasswordExpired']
        }) }}

    </div>

{% endblock %}

{% js %}
// Links in field instructions that point at another tab (e.g. #email-notifications)
// only change the hash on their own, which Craft's tab manager ignores once the
// page has loaded. Forward the click to the real tab so the panel actually switches.
document.addEventListener('click', function (event) {

    var link = event.target.closest ? event.target.closest('a[href*="#"]') : null;

    if (!link || !link.hash || link.getAttribute('role') === 'tab') {
        return;
    }

    if (link.pathname !== window.location.pathname) {
        return;
    }

    var tab = document.querySelector('a[role="tab"][href="' + link.hash + '"]');

    if (!tab) {
        return;
    }

    event.preventDefault();
    tab.click();

});
{% endjs %}
