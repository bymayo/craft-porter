{% if currentUser and craft.porter.settings.deactivateAccount %}

    {% set porterDeactivateAccountFlash = craft.app.session.getFlash('porter') %}

    {% if porterDeactivateAccountFlash|length %}
        <div class="{{ alertClass }}">
            {{ porterDeactivateAccountFlash }}
        </div>
    {% endif %}

    <form method="post" accept-charset="UTF-8">

        {{ csrfInput() }}
        {{ actionInput('porter/deactivate-account') }}
        {{ redirectInput(redirect) }}

        <button type="submit" class="{{ buttonClass }}" onclick="return confirm('{{ 'Deactivating your account results in you not being able to sign in. Are you sure you want to continue?'|t }}')">
            {{ buttonText }}
        </button>

    </form>

{% endif %}